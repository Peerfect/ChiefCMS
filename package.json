    "cheerio": "^1.1.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "iconv-lite": "^0.6.3",
    "ip2region": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "qiniu": "^7.14.0",
    "serve-favicon": "^2.5.1",
    "xml2js": "^0.6.2",
    "xss": "^1.0.15",
    "zod": "^4.1.11"
