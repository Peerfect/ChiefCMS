# 开发调试
PAGE_SIZE = 20
LIMIT_MAX = 300

# jwt配置 （注：生产环境一定要修改JWT_SECRET）
JWT_SECRET = ChanCMS
JWT_EXPIRES_IN = 1d
JWT_REFRESH = false

# salt 加盐
PASSWORD_SALT = 12
USER_SALT = 12
AES_SALT = chancms-aes-dev

# DB数据库配置
# 数据库类型：mysql 或 sqlite
DB_TYPE = mysql

# MySQL 配置
DB_HOST = localhost
DB_USER = root
DB_PASS = 123456
DB_PORT = 3306
DB_DATABASE = init
DB_POOL_MIN = 0
DB_POOL_MAX = 2

# SQLite 配置
DB_FILEPATH = ./data/init.sqlite

# 站点配置
PORT = 3000
BODY_LIMIT = 300kb
CORS_ORIGIN = *


# 日志级别配置
# 可选值说明：
# - dev: 开发模式（带颜色、极简，仅含请求方法/URL/状态码/响应时间，适合本地调试）
# - tiny: 超极简模式（体积最小，仅关键指标，适合高并发场景）
# - short: 轻量生产模式（比dev多客户端IP，无颜色，适合轻量生产环境）
# - common: 通用生产模式（兼容Apache通用日志格式，含IP/时间/请求信息，通用生产场景）
# - combined: 完整生产模式（信息最全，含IP/时间/来源页/客户端UA，适合需详细排查的生产场景）
# - chancms: 自定义业务模式（含ISO时间/真实IP/用户ID/请求信息/响应时间，贴合ChanCMS业务日志需求）
LOGGER_LEVEL = chancms

# node环境
NODE_ENV = dev

# 邮箱配置
EMAIL_HOST = smtp.qq.com
EMAIL_PORT = 587
EMAIL_USER = your-email@qq.com
EMAIL_PASS = zdzxzvjxenxhbfeb
EMAIL_FROM = your-email@qq.com
EMAIL_SECURE = true
EMAIL_CODE = 1234

# 收件人
EMAIL_TO = your-email@qq.com

# 微信公众号配置(微信公众号内登录)
WECHAT_APPID = your-appid
WECHAT_APPSECRET =  your-appsecret
WECHAT_REDIRECT_URI = your-redirect-uri.com
WECHAT_TOKEN = 123

## 微信开放平台配置（PC端扫码登录 正式）
WECHAT_OPEN_APPID=your-open-appid
WECHAT_OPEN_APPSECRET=your-open-appsecret

# 微信小程序配置
MINIPROGRAM_APPID=your-miniprogram-appid
MINIPROGRAM_APPSECRET=your-miniprogram-appsecret
